---
layout: layouts/base.njk
ogType: article
---
{% set ingredientSections = ingredients | parseIngredients %}
{% set directionSections = directions | parseDirections %}
{% set yield = servings | parseServings %}
{% set yieldText = servings | yieldLabel %}

<article class="recipe">
  <header class="recipe__header wrap">
    <p class="recipe__eyebrow"><a href="/">All recipes</a></p>
    <h1 class="recipe__title">{{ title }}</h1>
    {% if description %}<p class="recipe__description">{{ description }}</p>{% endif %}

    {% if tags | length %}
      <ul class="recipe__tags">
        {% for tag in tags %}
          <li><a href="/?tags={{ tag | urlencode }}">{{ tag }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if prepTime or cookTime or totalTime or yield %}
    <dl class="recipe__facts">
      {% if prepTime %}<div><dt>Prep</dt><dd>{{ prepTime }}</dd></div>{% endif %}
      {% if cookTime %}<div><dt>Cook</dt><dd>{{ cookTime }}</dd></div>{% endif %}
      {% if totalTime %}<div><dt>Total</dt><dd>{{ totalTime }}</dd></div>{% endif %}
      {% if yield %}
        <div>
          <dt>{{ yieldText.label }}</dt>
          <dd>
            <span
              data-servings
              {% if yield.quantity %}data-qty="{{ yield.quantity }}"{% endif %}
              {% if yield.quantityMax %}data-qty-max="{{ yield.quantityMax }}"{% endif %}
              data-unit="{{ yield.unit }}"
              {# When the prefix is the label, the scaler mustn't repeat it. #}
              data-prefix="{{ '' if yieldText.usesPrefix else yield.prefix }}"
              data-suffix="{{ yield.suffix }}"
            >{{ yieldText.text }}</span>
          </dd>
        </div>
      {% endif %}
    </dl>
    {% endif %}

    <div class="recipe__tools" data-recipe-tools>
      <button type="button" class="tool-button" data-wake-lock aria-pressed="false" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6.5" y="2" width="11" height="20" rx="2.5" /><path d="M10.5 18.5h3" /></svg>
        Keep screen on
      </button>
      {# The home-screen app has no browser menu, so printing needs a button. #}
      <button type="button" class="tool-button" data-print hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 9V3h10v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M7 14h10v7H7z" /></svg>
        Print
      </button>
      <button type="button" class="tool-button" data-checks-reset hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
        Clear checkmarks
      </button>
    </div>
  </header>

  {% if image %}
    <figure class="recipe__figure wrap">
      <img src="{{ image | versioned }}" alt="{{ imageAlt or title }}" width="1200" height="900" decoding="async">
    </figure>
  {% endif %}

  <div class="wrap recipe__grid">
    <section class="recipe__ingredients" aria-labelledby="ingredients-heading">
      <h2 id="ingredients-heading">Ingredients</h2>

      <div class="scaler" data-scaler>
        <span class="scaler__label" id="scaler-label">Scale</span>
        <div class="scaler__buttons" role="group" aria-labelledby="scaler-label">
          {% for step in [0.5, 1, 2, 3] %}
            <button
              type="button"
              class="scaler__button"
              data-scale="{{ step }}"
              aria-pressed="{{ 'true' if step == 1 else 'false' }}"
            >{{ step | formatQuantity }}&times;</button>
          {% endfor %}
        </div>
      </div>

      {% for section in ingredientSections %}
        {% set sectionIndex = loop.index0 %}
        {% if section.title %}
          <h3 class="ingredients__heading">{{ section.title | inlineMarkdown | safe }}</h3>
        {% endif %}
        <ul class="ingredients">
          {% for item in section.items %}
            {# The whole row is the label, so a tap anywhere ticks it off. #}
            <li class="ingredient">
              <label class="ingredient__row">
                <input type="checkbox" class="check" data-check="i{{ sectionIndex }}-{{ loop.index0 }}">
                <span class="ingredient__text">
                  {% if item.quantity %}
                    <span
                      class="ingredient__amount"
                      data-amount
                      data-qty="{{ item.quantity }}"
                      {% if item.quantityMax %}data-qty-max="{{ item.quantityMax }}"{% endif %}
                      data-unit="{{ item.unit }}"
                    >{{ item | formatAmount(1) }}</span>
                  {% endif %}
                  <span class="ingredient__name">{{ item.name | inlineMarkdown | safe }}</span>
                </span>
              </label>
            </li>
          {% endfor %}
        </ul>
      {% endfor %}
    </section>

    <section class="recipe__directions" aria-labelledby="directions-heading">
      <h2 id="directions-heading">Directions</h2>

      {# Quantities inside prose are left alone; saying so beats silently lying. #}
      <p class="scale-notice" data-scale-notice hidden>
        Amounts in the steps below are written for the original recipe.
      </p>

      {% for section in directionSections %}
        {% set sectionIndex = loop.index0 %}
        {% if section.title %}
          <h3 class="directions__heading">{{ section.title | inlineMarkdown | safe }}</h3>
        {% endif %}
        {# Each section is its own list, so numbering restarts at 1. #}
        <ol class="directions">
          {% for step in section.items %}
            {#
              The step number is the toggle. Steps can hold timer buttons, and
              a button can't live inside a <label>, so steps don't use one.
            #}
            <li class="step" data-step>
              <button
                type="button"
                class="step__check"
                data-check="s{{ sectionIndex }}-{{ loop.index0 }}"
                aria-pressed="false"
                aria-label="Step {{ loop.index }} done"
              ><span class="step__number">{{ loop.index }}</span></button>
              <div class="step__text">{{ step | inlineMarkdown | timerize | safe }}</div>
            </li>
          {% endfor %}
        </ol>
      {% endfor %}

      {% if content %}
        <div class="recipe__notes">
          <h2>Notes</h2>
          {{ content | safe }}
        </div>
      {% endif %}

      {% if nutrition %}
        <details class="recipe__nutrition">
          <summary>Nutrition (per serving, as published)</summary>
          <pre>{{ nutrition }}</pre>
        </details>
      {% endif %}

      {% if sourceUrl or source %}
        <p class="recipe__source">
          Adapted from
          {% if sourceUrl %}
            <a href="{{ sourceUrl }}" rel="noopener noreferrer nofollow">{{ source or sourceUrl }}</a>
          {% else %}
            {{ source }}
          {% endif %}
        </p>
      {% endif %}
    </section>
  </div>
</article>

{# Structured data mostly serves crawlers, so a private site leaves it out. #}
{% if not site.private %}
{% set schemaData = {
  title: title, description: description, image: image, servings: servings,
  source: source, sourceUrl: sourceUrl, tags: tags,
  ingredients: ingredients, directions: directions
} %}
<script type="application/ld+json">{{ schemaData | recipeSchema(site) | safe }}</script>
{% endif %}
